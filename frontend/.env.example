# API base URL used by the frontend when talking to the ORD FastAPI backend.
# Override this in a local .env file.
VITE_API_BASE_URL=http://localhost:8000
# Uncomment if using Next.js or CRA instead of Vite
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# REACT_APP_API_BASE_URL=http://localhost:8000
