# Application
APP_ENV=development
APP_DEBUG=true

# Postgres configuration (ORD defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ord
POSTGRES_USER=ord_user
POSTGRES_PASSWORD=ord_password

# DSNs referenced by ord-interface
ORD_INTERFACE_POSTGRES=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
